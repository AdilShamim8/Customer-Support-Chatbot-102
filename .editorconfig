# EditorConfig - consistent formatting across all editors and contributors
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,pyi}]
indent_size = 4
max_line_length = 100

[*.{yml,yaml}]
indent_size = 2

[*.{json,json5}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false
indent_size = 2

[*.{toml,ini,cfg}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2
final_newline = true

[*.{js,ts,jsx,tsx,css,scss,html}]
indent_size = 2

[*.tf]
indent_size = 2

[Dockerfile*]
indent_size = 4
