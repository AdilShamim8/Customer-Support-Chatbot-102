# ════════════════════════════════════════════════════════════════════════
# PRODUCTION environment template - 2026-10-15
#
# This file documents the FULL production surface. Actual values live in
# your secret manager (Kubernetes Secrets, Vault, AWS Secrets Manager).
# Copy to .env.production only for local production-shaped testing.
# ════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
SECRET_KEY=FROM_SECRET_MANAGER
API_RATE_LIMIT=100

# ── Authentication ( REQUIRED - no dev keys exist in production ) ────────────
ENABLE_AUTH=true
ADMIN_API_KEY=FROM_SECRET_MANAGER

# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=FROM_SECRET_MANAGER
COHERE_API_KEY=FROM_SECRET_MANAGER

# ── Models (pin versions in production - drift is a regression) ─────────────
CHAT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ── Storage (in-cluster DNS in Kubernetes) ───────────────────────────────────
REDIS_URL=redis://redis-master.chatbot.svc.cluster.local:6379/0
DATABASE_URL=postgresql+asyncpg://chatbot:FROM_SECRET_MANAGER@postgres.chatbot.svc.cluster.local:5432/chatbot_db
ELASTICSEARCH_URL=http://elasticsearch.chatbot.svc.cluster.local:9200

# ── Vector store ─────────────────────────────────────────────────────────────
VECTOR_STORE_TYPE=chroma
CHROMA_HOST=chroma.chatbot.svc.cluster.local
CHROMA_COLLECTION=support_docs

# ── Serving (production profile) ─────────────────────────────────────────────
WEB_CONCURRENCY=4
REQUEST_TIMEOUT_SECONDS=30
STREAM_FIRST_TOKEN_TIMEOUT_SECONDS=10
LLM_TIMEOUT_SECONDS=60
RETRIEVAL_TIMEOUT_SECONDS=5

# ── Resilience & caching (production values) ─────────────────────────────────
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_SECONDS=21600
ENABLE_CITATIONS=true
ENABLE_RERANKING=true

# ── Observability ────────────────────────────────────────────────────────────
ENABLE_TRACING=true
OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4317
SENTRY_DSN=FROM_SECRET_MANAGER
METRICS_ENABLED=true

# ── CORS (explicit allow-list; wildcard forbidden in production) ────────────
CORS_ORIGINS=https://ragchatbot1.space-z.ai
