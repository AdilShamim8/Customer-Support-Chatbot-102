# Force LF line endings for all text files.
# Pairs with .editorconfig; prevents the CRLF/LF mix that previously
# produced whole-file diffs (fixed 2026-10-15).
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets - never normalize
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.faiss binary
*.safetensors binary
*.onnx binary
*.db binary
*.sqlite3 binary

# Shell scripts must stay executable-looking to git
*.sh text eol=lf
